# Создайте .env.prod через scripts/create_prod_env.py. Не используйте dev .env.
DOMAIN=news.example.com
LETSENCRYPT_EMAIL=admin@example.com
TLS_MODE=https
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DEMO_MODE=False
DJANGO_ALLOWED_HOSTS=news.example.com
COOKIE_SECURE=True
CSRF_TRUSTED_ORIGINS=https://news.example.com
CORS_ALLOWED_ORIGINS=
SECURE_SSL_REDIRECT=True
TRUST_PROXY_SSL_HEADER=True
SECURE_HSTS_SECONDS=3600
# Включайте только после проверки HTTPS для ВСЕХ поддоменов и условий preload.
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
POSTGRES_DB=news_blog_db
POSTGRES_USER=news_blog
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_APP_USER=news_blog_app
POSTGRES_APP_PASSWORD=replace-with-another-random-password
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60
