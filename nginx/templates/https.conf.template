log_format news_blog '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';
access_log /var/log/nginx/access.log news_blog;
server_tokens off;
server { listen 8081; server_name localhost; location = /nginx-health { access_log off; return 200 "ok"; } }
server { listen 80 default_server; server_name _; return 444; }
server {
    listen 80;
    server_name ${DOMAIN};
    location ^~ /.well-known/acme-challenge/ { root /var/www/certbot; try_files $uri =404; }
    location / { return 308 https://${DOMAIN}$request_uri; }
}
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}
server {
    listen 443 ssl;
    server_name ${DOMAIN};
    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    server_tokens off;
    client_max_body_size 6m;
    root /usr/share/nginx/html;
    include /etc/news-blog/security-headers.conf;
    location /api/ { include /etc/news-blog/proxy.conf; }
    location /admin/ { include /etc/news-blog/proxy.conf; }
    location = /health/ { include /etc/news-blog/proxy.conf; }
    location /static/ { alias /srv/static/; }
    location /media/ {
        alias /srv/media/;
        # Uploaded content cannot execute scripts in the site's origin.
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;
        include /etc/news-blog/security-headers.conf;
    }
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/news-blog/security-headers.conf;
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
        include /etc/news-blog/security-headers.conf;
    }
    location / { try_files $uri $uri/ /index.html; }
}
